{% extends 'layout.html.twig' %}

{% block title %}Liste des membres - {{ site_name }}{% endblock %}

{% block breadcrumbs %}
<a href="{{ path('homepage') }}"><i class="material-icons">home</i></a><i class="material-icons">chevron_right</i>
<a href="{{ path('admin') }}"><i class="material-icons">build</i>&nbsp;Administration</a><i class="material-icons">chevron_right</i>
<i class="material-icons">people</i>&nbsp;Liste des membres
{% endblock %}

{% block content %}
    <div class="row center">
        <h4 class="header">Liste des membres ({{ result_count }})</h4>
    </div>

    {% include 'admin/user/_member_filters.html.twig' with {form: form, open: false, buttons: ['submit', 'csv']} only %}
    </div> <!-- end div.section -->
    </div> <!-- end div.container -->
    <table class="highlight">
        <thead>
            <tr>
                <th class="hide-on-med-and-down">Etat</th>
                <th data-col="m.member_number">#</th>
                <th data-col="u.username">username</th>
                <th data-col="b.firstname">prénom</th>
                <th data-col="b.lastname">nom</th>
                <th data-col="u.email">email</th>
                <th data-col="r.date" class="hide-on-small-and-down">Adhésion(s)</th>
                <th class="hide-on-med-and-down">Formation(s)</th>
                <th class="hide-on-med-and-down">Commission(s)</th>
            </tr>
        </thead>
        <tbody>
        {% for member in members %}
            {% if member.mainBeneficiary %}
                <tr id="member_{{ member.id }}" data-url="{{ path('member_show', { 'member_number': member.memberNumber }) }}" class="{% if member.withdrawn %}withdrawn{% elseif member.frozen %}frozen{% elseif member.isCurrentlyExemptedFromShifts() %}exempted{% endif %}" data-cy="member_{{ member.id }}">
                    <td class="hide-on-med-and-down">
                        {% include "admin/member/_partial/status_icons.html.twig" with { member: member } %}
                    </td>
                    <td>
                        <a href="{{ path('member_show', { 'member_number': member.memberNumber }) }}">{{ member.memberNumber }}</a>
                    </td>
                    <td>
                        {% for beneficiary in member.beneficiaries %}
                            {{ beneficiary.user.username }}<br />
                        {% endfor %}
                    </td>
                    <td>
                        {% for beneficiary in member.beneficiaries %}
                            {{ beneficiary.firstname }}<br />
                        {% endfor %}
                    </td>
                    <td>
                        {% for beneficiary in member.beneficiaries %}
                            {{ beneficiary.lastname }}<br />
                        {% endfor %}
                    </td>
                    <td>
                        {% for beneficiary in member.beneficiaries %}
                            {{ beneficiary.email }}<br />
                        {% endfor %}
                    </td>
                    <td class="hide-on-small-and-down">
                        {% for registration in member.registrations %}
                            {% if member.lastregistration %}
                                {% if registration.id == member.lastregistration.id %}<strong>{% else %}<del>{% endif %}
                                {{ registration.date | date_short }}
                                {% if registration.id == member.lastregistration.id %}</strong>{% else %}</del>{% endif %}
                                <br />
                            {% else %}
                                {{ registration.date | date_short }}
                                /!\ need fix
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td class="hide-on-med-and-down">
                        {% for beneficiary in member.beneficiaries %}
                            {% for formation in beneficiary.formations %}
                                <div class="chip">
                                    {{ formation.name }}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </td>
                    <td class="hide-on-med-and-down">
                        {% for beneficiary in member.beneficiaries %}
                            {% for commission in beneficiary.commissions %}
                                <div class="chip">
                                    {{ commission.name }}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </td>
                </tr>
            {% else %}
                <tr id="member_{{ member.id }}" data-url="{{ path('member_show', { 'member_number': member.memberNumber }) }}" class="{% if member.withdrawn %}withdrawn{% endif %} {% if member.frozen %}frozen{% endif %}" data-cy="member_{{ member.id }}">
                    <td colspan="9">{{ member }}</td>
                </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
<div class="container">
    <div class="section">
    {% if page_count > 1 %}
    <ul class="pagination">
        <li class="{% if(current_page==1) %}disabled{% else %}waves-effect{% endif %}">
            <a href="{% if(current_page==1) %}#!{% else %}{{ path("user_index", {'page':current_page-1}) }}{% endif %}" data-page="{{ current_page-1 }}">
                <i class="material-icons">chevron_left</i>
            </a>
        </li>
        {% if page_count < 10 %}
            {% for i in range(1, page_count) %}
                <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
            {% endfor %}
        {% else %}
            {% if current_page <= 3 %}
                {% for i in range(1, current_page+1) %}
                    <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                {% endfor %}
                <li>...</li>
                {% for i in range(page_count-1, page_count) %}
                    <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                {% endfor %}
            {% else %}
                {% if page_count - current_page <= 3 %}
                    {% for i in range(1, 2) %}
                        <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                    {% endfor %}
                    <li>...</li>
                    {% for i in range(current_page-1, page_count) %}
                        <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                    {% endfor %}
                {% else %}
                    {% for i in range(1, 2) %}
                    <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                    {% endfor %}
                    <li>...</li>
                    {% for i in range(current_page-1, current_page+1) %}
                        <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                    {% endfor %}
                    <li>...</li>
                    {% for i in range(page_count-1, page_count) %}
                        <li class="{% if(current_page==i) %}active{% else %}waves-effect{% endif %}"><a href="#" data-page="{{ i }}">{{ i }}</a></li>
                    {% endfor %}
                {% endif %}
            {% endif %}
        {% endif %}
        <li class="{% if(current_page==page_count) %}disabled{% else %}waves-effect{% endif %}">
            <a href="{% if(current_page==page_count) %}#!{% else %}{{ path("user_index", {'page':current_page+1}) }}{% endif %}" data-page="{{ current_page+1 }}">
                <i class="material-icons">chevron_right</i>
            </a>
        </li>
    </ul>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    <style>
        th.active {
            color: {{ main_color }};
        }
        th[data-col] {
            cursor: pointer;
        }
        tr.frozen {
            background-image: url({{ asset("build/images/snowflakes.svg") }});
            background-position: top right;
            background-repeat: no-repeat;
            background-size: contain;
        }
        tr.frozen td {
            background-color: rgba(255, 255, 255, 0.5);
        }
        tbody tr {
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block javascripts %}
    <script>
        jQuery(function(){
            $('tr').click(function () {
               var url = $(this).data('url');
               if (url){
                   window.location = url;
               }
            });
            $('[type=submit]').click(function(e){
                e.preventDefault();
                $('#form_action').val($(this).val());
                $('form[name=form]').submit();
            });
            $('.pagination li:not(.disabled) a').click(function(e){
                e.preventDefault();
                $('#form_page').val($(this).data('page'));
                $('form[name=form]').submit();
            });
            $('th[data-col]').click(function(e){
                e.preventDefault();
                if ($('#form_sort').val() === $(this).attr('data-col')){
                    $('#form_dir').val(($('#form_dir').val() === 'ASC') ? 'DESC' : 'ASC');
                }else{
                    $('#form_sort').val($(this).attr('data-col'));
                }
                $('th[data-col]').removeClass('active');
                $(this).addClass('active');
                $('form[name=form]').submit();
            });
            $('th[data-col="'+$('#form_sort').val()+'"]').addClass('active');
        });
    </script>
{% endblock %}
